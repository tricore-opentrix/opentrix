# Template only: provide values for your local environment; no real credentials here.
# Spring Boot currently does not automatically load .env.
# An external/local mechanism must supply these variables to the application process.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

OIDC_ISSUER_URI=http://localhost:8180/realms/tricore
OIDC_AUDIENCE=tricore-api
OIDC_RESOURCE_CLIENT_ID=tricore-api

# --- Demo integration-local (#119) ---
# `demo-up` tự sinh các giá trị này vào infra/.env (ngẫu nhiên, 32 ký tự hex). KHÔNG commit `.env`.
# Chỉ cần sửa tay khi muốn đổi tên hiển thị hoặc đặt mật khẩu riêng cho máy demo.
HELPDESK_SETUP_PASSWORD=change-me
HELPDESK_RUNTIME_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
PORTAL_OIDC_CLIENT_SECRET=change-me
GATEWAY_MONITOR_CLIENT_SECRET=change-me
DEMO_EMPLOYEE_PASSWORD=change-me
DEMO_COORDINATOR_PASSWORD=change-me
DEMO_WORKER_PASSWORD=change-me
DEMO_EMPLOYEE_NAME=Nhan vien demo
DEMO_COORDINATOR_NAME=Dieu phoi demo
DEMO_WORKER_NAME=Ky thuat vien demo
